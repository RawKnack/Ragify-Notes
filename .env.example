# Google Gemini API Key for Vision OCR and Response Generation
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Model Configuration ────────────────────────────────────────────
GEMINI_MODEL=gemini-3.6-flash

EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL_NAME=ms-marco-TinyBERT-L-2-v2

# ── Storage & Vector Store ─────────────────────────────────────────
FAISS_INDEX_PATH=./faiss_index
INPUT_PDF_DIR=Data/input_pdfs
OUTPUT_JSON=Data/output_json/output.json
CHUNKS_JSON=Data/output_json/chunks.json

# ── Retrieval Parameters ───────────────────────────────────────────
RRF_K=60
DEFAULT_ALPHA=0.6
DEFAULT_TOP_K=5

# ── Benchmarking & Server ──────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=RagifyNotes-RAG-Benchmark
PORT=7860
